# Copy to .env and fill in:  cp env.example .env
# `docker compose` reads .env automatically.

# REQUIRED. Passphrase that encrypts data/credentials.enc. cockpit refuses to
# start without it. Generate one with:
#   openssl rand -base64 32
# Keep a backup — losing it means re-entering every widget connection.
COCKPIT_SECRET=

# Recommended whenever anything other than this machine can reach cockpit. Set
# it and every request needs the token (entered once at /login). Unset, cockpit
# is open, which is only acceptable while it is bound to loopback.
#   openssl rand -base64 24
COCKPIT_ACCESS_TOKEN=

# Timezone for calendars and the scheduler. Without it the container runs UTC.
TZ=Europe/Berlin

# Optional. Name used in the greeting and the assistant's system prompt.
COCKPIT_USER_NAME=

# Optional. Host port to publish on (inside the container it is always 3000).
COCKPIT_PORT=3000

# Optional. Allow server-side fetches of private/LAN addresses. Off by default
# so a crafted feed or calendar URL cannot make cockpit probe your network.
# Turn it on only if your own RSS feeds or iCal URLs are internal.
# COCKPIT_ALLOW_PRIVATE_FETCH=1

# Optional, macOS only. Use the system Keychain instead of the encrypted file
# (then COCKPIT_SECRET is not needed).
# COCKPIT_KEYCHAIN=1
