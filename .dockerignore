# Docker ignore patterns are NOT recursive: a bare `.env.*` matches only the
# context root, so anything nested needs an explicit `**/`. Getting that wrong
# once put apps/web/.env.local — a real COCKPIT_SECRET — inside an image.

# Secrets and local state. Deliberately first, and deliberately over-broad.
**/.env
**/.env.*
!**/env.example
**/*.pem
**/*.key
**/id_rsa*

# The maintainer's own data: the SQLite database and the encrypted credentials.
data/
**/data/
**/*.sqlite
**/*.sqlite-shm
**/*.sqlite-wal

# Dependencies and build output — reinstalled and rebuilt inside the image.
**/node_modules/
**/.next/
**/.turbo/
**/dist/
**/out/
**/*.tsbuildinfo

# Not needed at build or run time.
.git/
.gitignore
.gitattributes
.github/
.claude/
docs/
ops/
**/*.md
**/*.log
**/.DS_Store
compose.yaml
Dockerfile
.dockerignore
