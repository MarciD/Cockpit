{
  "$schema": "https://turbo.build/schema.json",
  "globalPassThroughEnv": ["COCKPIT_*", "TZ", "PORT", "HOSTNAME"],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": [".next/**", "!.next/cache/**", "dist/**"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "check-types": {
      "dependsOn": ["^build"]
    }
  }
}
